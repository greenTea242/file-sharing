<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% block title %}{% endblock %}
		</title>
	</head>
	<body>
		<nav class="navbar navbar-expand-sm bg-dark navbar-dark">
			<div class="container-fluid">
				<a class="navbar-brand" href="{{ url_for('files.upload.form') }}">Файлообменник</a>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarContent">
					<ul class="navbar-nav me-auto">
						<li class="nav-item">
							<a class="nav-link {{ activeTab == 'fileUpload' ? 'active' : '' }}" href="{{ url_for('files.upload.form') }}">Загрузка файла</a>
						</li>
						<li class="nav-item">
							<a class="nav-link {{ activeTab == 'recentFiles' ? 'active' : '' }}" href="{{ url_for('files') }}">Последние файлы</a>
						</li>
						{% if user is defined and
							  user.isRegistered() and
							  user.hasFiles() %}
							<li class="nav-item">
								<a class="nav-link {{ activeTab == 'userFiles' ? 'active' : '' }}" href="{{ url_for('users.files', {'id': user.getId()}) }}">Мои файлы</a>
							</li>
						{% endif %}
					</ul>
					<form class="d-flex" action="{{ url_for('files.search') }}">
						<input class="form-control me-2" name="q" type="search" placeholder="Поиск файлов">
						<button class="btn btn-outline-success" type="submit">Искать</button>
					</form>
				</div>
			</div>
		</nav>
		{% block body %}{% endblock %}
		<script src="/js/bundle.js"></script>
	</body>
</html>
