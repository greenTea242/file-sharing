{
    "name": "greentea242/file-sharing",
    "description": "Simple service for sharing files",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "james-heinrich/getid3": "v2.0.0-beta6",
        "monolog/monolog": "^3.10",
        "php-ffmpeg/php-ffmpeg": "^1.4",
        "pimple/pimple": "^3.6",
        "predis/predis": "^3.4",
        "slim/csrf": "^1.5",
        "slim/flash": "^0.4",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "slim/twig-view": "^3.4",
        "twbs/bootstrap": "^5.3",
        "twig/twig": "^3.23",
        "workerman/redis": "^2.0",
        "workerman/redis-queue": "^1.2",
        "workerman/workerman": "^5.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}